{
    "name": "@universo-react/theme",
    "version": "0.1.0",
    "description": "Typed theme-preset registry, server-side resolver, and MUI adapter for Universo Platformo layouts",
    "private": true,
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./resolve": {
            "types": "./dist/resolve.d.ts",
            "import": "./dist/resolve.mjs",
            "require": "./dist/resolve.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "scripts": {
        "clean": "rimraf dist",
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint": "eslint --ext .ts src/",
        "test": "vitest run --config vitest.config.ts"
    },
    "license": "Omsk Open License",
    "devDependencies": {
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "rimraf": "^5.0.5",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@universo-react/types": "workspace:*",
        "@universo-react/utils": "workspace:*"
    }
}
